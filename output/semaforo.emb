##algoritmo semaforo
configuracion:
    numpin led_rojo = 13;
    numpin led_amarillo = 12;
    numpin led_verde = 11;
    
    configurar (13, salida);
    configurar (12, salida);
    configurar (11, salida);
fin

circuito:
    
    encender(led_rojo); 
    esperar(5000);
    apagar(led_verde);
    
    encender(12);
    esperar(2000);
    apagar(12);
    
    encender(13);
    esperar(5000);
    apagar(13);
    
    encender(12);
    esperar(1000);
    apagar(12);
fin
